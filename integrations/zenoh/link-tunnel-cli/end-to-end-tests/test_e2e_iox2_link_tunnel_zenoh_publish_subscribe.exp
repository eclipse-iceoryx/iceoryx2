#### Common Setup

set REPO_ROOT [exec git rev-parse --show-toplevel]
cd ${REPO_ROOT}

source ${REPO_ROOT}/internal/end-to-end-testing/common.exp

#### Test Setup

set timeout 15

exec cargo build -p example 2>@1
exec cargo build --manifest-path integrations/zenoh/Cargo.toml -p iceoryx2-integrations-zenoh-link-tunnel-cli 2>@1

#### Test

# The tunnel at trace level, the bridge lines of the link are trace.
set env(IOX2_LOG_LEVEL) trace
spawn cargo run --manifest-path integrations/zenoh/Cargo.toml --bin iox2-link-tunnel-zenoh -- --monitor
set id_tunnel $spawn_id
unset env(IOX2_LOG_LEVEL)
expect_output_from $id_tunnel "Tunnel started"

spawn cargo run --example publish_subscribe_publisher
set id_publisher $spawn_id
expect_output_from $id_publisher "Send sample"

#### Test Assertion

expect_output_from $id_tunnel "Opened PublishSubscribe bridge of \"My/Funk/ServiceName\""
expect_output_from $id_tunnel "Relayed PublishSubscribe bridge of \"My/Funk/ServiceName\""

#### Shutdown

send -i $id_publisher $SIGINT
expect -i $id_publisher eof

send -i $id_tunnel $SIGINT
expect_output_from $id_tunnel "Tunnel stopped"
expect -i $id_tunnel eof

show_test_passed
