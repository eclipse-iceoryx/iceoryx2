# Generated by `colcon build` via colcon-ros-cargo, patching the message
# crate dependencies to the install space.
/.cargo/

# Dontents are specific to the distro that built it.
/src/demo_nodes/Cargo.lock

# Imported by `vcs import src < <distro>.repos`.
/src/common_interfaces/
/src/rcl_interfaces/
/src/rosidl_rust/

# Colcon build artifacts, when not redirected out of the workspace.
/build/
/install/
/log/
