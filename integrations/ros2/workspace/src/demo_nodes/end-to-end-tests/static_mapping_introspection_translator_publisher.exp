#### Common Setup

set REPO_ROOT [exec git rev-parse --show-toplevel]
cd ${REPO_ROOT}

source ${REPO_ROOT}/internal/end-to-end-testing/common.exp

#### Test Setup

set MAPPING integrations/ros2/workspace/src/demo_nodes/static_mapping_cmdvel.toml

exec cargo build --manifest-path integrations/ros2/Cargo.toml \
    --bin iox2-tunnel-ros2 2>@1

#### Test

set timeout 30

# The mapping pairs the example's service `CmdVel` with the ROS 2 topic
# `/cmd_vel`, kept separate from the chatter mapping because the introspection
# translator admits fixed-size types only.
spawn cargo run --manifest-path integrations/ros2/Cargo.toml \
    --bin iox2-tunnel-ros2 -- \
    --static-mapping ${MAPPING} \
    --translator introspection
set id_tunnel $spawn_id
expect_output_from $id_tunnel "Local Discovery via Tracker"

spawn ros2 run demo_nodes_iceoryx2 \
    static_mapping_introspection_translator_publisher
set id_publisher $spawn_id
expect_output_from $id_publisher "send:"

spawn ros2 topic echo /cmd_vel
set id_echo $spawn_id

#### Test Assertion

expect_output_from $id_tunnel "Opening bridge"
expect_output_from $id_tunnel "Propagated PublishSubscribe"

# The native struct the example published arrives as a ROS 2 message, having
# been transcoded to CDR by the tunnel.
expect_output_from $id_echo "x: 0.5"

#### Shutdown

send -i $id_echo $SIGINT
expect -i $id_echo eof

send -i $id_publisher $SIGINT
expect -i $id_publisher eof

send -i $id_tunnel $SIGINT
expect_output_from $id_tunnel "Tunnel stopped"
expect -i $id_tunnel eof

show_test_passed
