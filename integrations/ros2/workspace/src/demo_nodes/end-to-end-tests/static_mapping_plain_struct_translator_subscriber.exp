#### Common Setup

set REPO_ROOT [exec git rev-parse --show-toplevel]
cd ${REPO_ROOT}

source ${REPO_ROOT}/internal/end-to-end-testing/common.exp

#### Test Setup

set MAPPING integrations/ros2/workspace/src/demo_nodes/static_mapping_cmdvel.toml

exec cargo build --manifest-path integrations/ros2/Cargo.toml \
    --bin iox2-gateway-ros2 2>@1

#### Test

set timeout 30

# The mapping pairs the example's service `CmdVel` with the ROS 2 topic
# `/cmd_vel` and doubles as the wire-side discovery allowlist.
spawn cargo run --manifest-path integrations/ros2/Cargo.toml \
    --bin iox2-gateway-ros2 -- \
    --static-mapping ${MAPPING} \
    --translator PlainStruct
set id_gateway $spawn_id
expect_output_from $id_gateway "Local Discovery via Tracker"

spawn ros2 run demo_nodes_iceoryx2 \
    static_mapping_plain_struct_translator_subscriber
set id_subscriber $spawn_id
expect_output_from $id_subscriber "waiting for messages on CmdVel"

spawn ros2 topic pub -r 5 /cmd_vel geometry_msgs/msg/Twist "{linear: {x: 0.5}}"
set id_publisher $spawn_id

#### Test Assertion

expect_output_from $id_gateway "Opening bridge"
expect_output_from $id_gateway "Ingested PublishSubscribe"

# The ROS 2 message arrives as the native struct, having been transcoded from
# CDR by the gateway.
expect_output_from $id_subscriber "x: 0.5"

#### Shutdown

send -i $id_publisher $SIGINT
expect -i $id_publisher eof

send -i $id_subscriber $SIGINT
expect -i $id_subscriber eof

send -i $id_gateway $SIGINT
expect_output_from $id_gateway "Gateway stopped"
expect -i $id_gateway eof

show_test_passed
