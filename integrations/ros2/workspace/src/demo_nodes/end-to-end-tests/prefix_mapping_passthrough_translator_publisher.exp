#### Common Setup

set REPO_ROOT [exec git rev-parse --show-toplevel]
cd ${REPO_ROOT}

source ${REPO_ROOT}/internal/end-to-end-testing/common.exp

#### Test Setup

exec cargo build --manifest-path integrations/ros2/Cargo.toml \
    --bin iox2-gateway-ros2 2>@1

#### Test

set timeout 30

# The example publishes on `ros2://topics/chatter`, which the gateway maps to
# the ROS 2 topic `/chatter` by the name prefix without further configuration.
spawn cargo run --manifest-path integrations/ros2/Cargo.toml \
    --bin iox2-gateway-ros2
set id_gateway $spawn_id
expect_output_from $id_gateway "Local Discovery via Tracker"

spawn ros2 run demo_nodes_iceoryx2 \
    prefix_mapping_passthrough_translator_publisher
set id_publisher $spawn_id
expect_output_from $id_publisher "Hello from iceoryx2"

spawn ros2 topic echo /chatter std_msgs/msg/String
set id_echo $spawn_id

#### Test Assertion

expect_output_from $id_gateway "Opening bridge"
expect_output_from $id_gateway "Propagated PublishSubscribe"

# The CDR the example serialized itself arrives as a ROS 2 message.
expect_output_from $id_echo "Hello from iceoryx2"

#### Shutdown

send -i $id_echo $SIGINT
expect -i $id_echo eof

send -i $id_publisher $SIGINT
expect -i $id_publisher eof

send -i $id_gateway $SIGINT
expect_output_from $id_gateway "Gateway stopped"
expect -i $id_gateway eof

show_test_passed
