#### Common Setup

set REPO_ROOT [exec git rev-parse --show-toplevel]
cd ${REPO_ROOT}

source ${REPO_ROOT}/internal/end-to-end-testing/common.exp

#### Test Setup

exec cargo build --manifest-path integrations/ros2/Cargo.toml \
    -p iceoryx2-integrations-ros2-examples --examples 2>@1

#### Test

set timeout 30

set env(IOX2_LOG_LEVEL) trace
spawn cargo run --manifest-path integrations/ros2/Cargo.toml \
    -p iceoryx2-integrations-ros2-examples --example flatbuffer_gateway
set id_gateway $spawn_id
drain_output $id_gateway
unset env(IOX2_LOG_LEVEL)

expect_output_from $id_gateway "gateway running"

# The durability is spelled out as the default differs between distros and
# the mapping expects a volatile topic.
spawn ros2 topic pub -r 5 --qos-durability volatile /pose geometry_msgs/msg/PoseStamped \
    "{header: {frame_id: world}, pose: {position: {x: 1.0}, orientation: {w: 1.0}}}"
set id_pub $spawn_id
drain_output $id_pub

# The gateway creates the service from the schema the translator embeds.
expect_output_from $id_gateway "Opened PublishSubscribe bridge of \"Pose\""

spawn cargo run --manifest-path integrations/ros2/Cargo.toml \
    -p iceoryx2-integrations-ros2-examples --example flatbuffer_pose_subscriber
set id_subscriber $spawn_id

#### Test Assertion

# The PoseStamped arrives as a Pose flatbuffer.
expect_output_from $id_subscriber "received: frame \"world\""
expect_output_from $id_subscriber "position (1.0, 0.0, 0.0)"

#### Shutdown

send -i $id_subscriber $SIGINT
expect -i $id_subscriber eof

send -i $id_pub $SIGINT
expect -i $id_pub eof

send -i $id_gateway $SIGINT
expect -i $id_gateway eof

show_test_passed
