#### Common Setup

set REPO_ROOT [exec git rev-parse --show-toplevel]
cd ${REPO_ROOT}

source ${REPO_ROOT}/internal/end-to-end-testing/common.exp

#### Test Setup

exec cargo build --manifest-path integrations/ros2/Cargo.toml \
    -p iceoryx2-integrations-ros2-examples --examples 2>@1

#### Test

set timeout 30

set env(IOX2_LOG_LEVEL) trace
spawn cargo run --manifest-path integrations/ros2/Cargo.toml \
    -p iceoryx2-integrations-ros2-examples --example flatbuffer_gateway
set id_gateway $spawn_id
drain_output $id_gateway
unset env(IOX2_LOG_LEVEL)

expect_output_from $id_gateway "gateway running"

spawn cargo run --manifest-path integrations/ros2/Cargo.toml \
    -p iceoryx2-integrations-ros2-examples --example flatbuffer_joint_readings_publisher
set id_publisher $spawn_id

expect_output_from $id_gateway "Opened PublishSubscribe bridge of \"JointReadings\""

spawn ros2 topic echo /joint_states sensor_msgs/msg/JointState
set id_echo $spawn_id

#### Test Assertion

# The flatbuffer's readings arrive as a JointState.
expect_output_from $id_echo "frame_id: base"
expect_pattern_from $id_echo "name:\r?\n- shoulder\r?\n- elbow" "the joint names"

#### Shutdown

send -i $id_echo $SIGINT
expect -i $id_echo eof

send -i $id_publisher $SIGINT
expect -i $id_publisher eof

send -i $id_gateway $SIGINT
expect -i $id_gateway eof

show_test_passed
