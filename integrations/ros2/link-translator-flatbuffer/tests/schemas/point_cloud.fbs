namespace builtin_interfaces.msg;

struct Time {
    sec: int32;
    nanosec: uint32;
}

namespace std_msgs.msg;

table Header {
    stamp: builtin_interfaces.msg.Time;
    frame_id: string;
}

namespace geometry_msgs.msg;

table Point32 {
    x: float32;
    y: float32;
    z: float32;
}

namespace sensor_msgs.msg;

table ChannelFloat32 {
    name: string;
    values: [float32];
}

table PointCloud {
    header: std_msgs.msg.Header;
    points: [geometry_msgs.msg.Point32];
    channels: [ChannelFloat32];
}

root_type PointCloud;
