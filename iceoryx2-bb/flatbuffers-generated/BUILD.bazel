load("@rules_rs//rs:rust_library.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

rust_library(
    name = "iceoryx2-bb-flatbuffers-generated",
    srcs = glob([
        "src/**/*.rs",
        "binding/*.rs",
    ]),
    compile_data = glob(["schema/*.bfbs"]),
    crate_features = select({
        "//:cfg_feature_std": [
            "std",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "@crate_index//:flatbuffers",
    ],
)
