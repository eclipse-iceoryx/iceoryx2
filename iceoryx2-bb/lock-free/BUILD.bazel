load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

rust_library(
    name = "iceoryx2-bb-lock-free",
    srcs = glob(["src/**/*.rs"]),
    crate_features = select({
        "//:cfg_feature_std": [
            "std",
        ],
        "//conditions:default": [],
    }),
    proc_macro_deps = [
        "//iceoryx2-bb/derive-macros:iceoryx2-bb-derive-macros",
    ],
    deps = [
        "//iceoryx2-bb/concurrency:iceoryx2-bb-concurrency",
        "//iceoryx2-bb/elementary:iceoryx2-bb-elementary",
        "//iceoryx2-bb/elementary-traits:iceoryx2-bb-elementary-traits",
        "//iceoryx2-log/log:iceoryx2-log",
    ],
)

rust_test(
    name = "iceoryx2-bb-lock-free-tests",
    srcs = ["tests/tests.rs"],
    crate_features = ["std"],
    use_libtest_harness = False,
    deps = [
        "//iceoryx2-bb/lock-free/tests-common:iceoryx2-bb-lock-free-tests-common",
        "//iceoryx2-bb/testing:iceoryx2-bb-testing",
    ],
)
