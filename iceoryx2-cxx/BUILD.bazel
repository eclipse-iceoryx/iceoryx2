package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:configure_file.bzl", "configure_file")

configure_file(
    name = "iceoryx2_cxx_deployment",
    template = "cmake/iceoryx2_cxx_deployment.hpp.in",
    out = "include/iox2/iceoryx2_cxx_deployment.hpp",
    # NOTE: format for substitutions is
    #       substitutions = ["FOO_ENABLED"] + select({ "//:cfg_foo": ["1"], "//conditions:default": ["0"] }) # replaces "@FOO_ENABLED@" with the selected value
    #                     + ["BAR_ENABLED"] + select({ "//:cfg_bar": ["1"], "//conditions:default": ["0"] }) # replaces "@BAR_ENABLED@" with the selected value
    substitutions = ["IOX2_FEATURE_FLATBUFFERS_ENABLED"] + select({ "//:cfg_feature_flatbuffers": ["1"], "//conditions:default": ["0"] })
)

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

cc_library(
    name = "iceoryx2-cxx-shared",
    srcs = glob(
        [
            "src/**",
        ],
    ),
    hdrs = glob(["include/**"]) + [
        ":iceoryx2_cxx_deployment",
    ],
    strip_include_prefix = "include",
    deps = [
        "//:iceoryx2-c-shared",
        "//:iceoryx2-bb-cxx",
    ] + select({
        "//:cfg_feature_flatbuffers": ["@flatbuffers//:flatbuffers"],
        "//conditions:default": []
    }),
    linkstatic = False,
)

cc_library(
    name = "iceoryx2-cxx-static",
    srcs = glob(
        [
            "src/**",
        ],
    ),
    hdrs = glob(["include/**"]) + [
        ":iceoryx2_cxx_deployment",
    ],
    strip_include_prefix = "include",
    deps = [
        "//:iceoryx2-c-static",
        "//:iceoryx2-bb-cxx",
    ] + select({
        "//:cfg_feature_flatbuffers": ["@flatbuffers//:flatbuffers"],
        "//conditions:default": []
    }),
    linkstatic = True,
)
