###############################################################################
# Bazel now uses Bzlmod by default to manage external dependencies.
# Please consider migrating your external dependencies from WORKSPACE to MODULE.bazel.
#
# For more details, please check https://github.com/bazelbuild/bazel/issues/18958
###############################################################################
module(
    name = "iceoryx2",
    version = "0.10.999",
    bazel_compatibility = [">=7.5.0"],
)

bazel_dep(name = "bazel_features", version = "1.51.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# NOTE: keep in sync with Iceoryx2GTest.cmake
bazel_dep(name = "googletest", version = "1.16.0", dev_dependency = True)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")

# NOTE: keep in sync with Cargo.toml and Iceoryx2Flatbuffers.cmake
bazel_dep(name = "flatbuffers", version = "25.12.19")

# Rust rules and toolchains share the patched rules_rust repository.
bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "llvm", version = "0.8.18")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

rust = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust.toolchain(
    edition = "2024",
    version = "1.89.0",
)
use_repo(rust, "default_rust_toolchains")

# Bindgen toolchain setup
# rules_rs provides self-contained bindgen binaries, including libclang.
# These toolchains are registered both when building iceoryx2 directly and
# when using it as a dependency; consumers need no separate libclang setup.
bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(bindgen, "rules_rust_bindgen")

register_toolchains(
    "@default_rust_toolchains//...",
    "@rules_rust_bindgen//:all",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.annotation(
    crate = "cbindgen",
    gen_binaries = ["cbindgen"],
)
crate.from_cargo(
    name = "crate_index",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-nto-qnx710",
        "aarch64-unknown-nto-qnx800",
        "x86_64-apple-darwin",
        "x86_64-pc-nto-qnx710",
        "x86_64-pc-nto-qnx800",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crate_index")

# Compatibility with Bazel 7.5.
single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = ["//bazel:rules_rs_bazel7.patch"],
)

single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = ["//bazel:llvm_bazel7.patch"],
)
