load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel/cbindgen:cbindgen.bzl", "rust_cbindgen_headers")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

rust_cbindgen_headers(
    name = "iceoryx2-ffi-c-cbindgen",
    srcs = glob(["src/**/*.rs"]) + ["//:all_srcs"],
    config = "cbindgen.toml",
    header = "include/iox2/iceoryx2.h",
    manifest_dir = "Cargo.toml",
)

ICEORYX2_FFI_C_SRC = glob(["src/**/*.rs"])

ICEORYX2_FFI_C_FEATURES = select({
    "//:cfg_feature_std": ["std"],
    "//conditions:default": ["std"],
})

ICEORYX2_FFI_C_DEPS = [
    "//iceoryx2:iceoryx2",
    "//iceoryx2-bb/container:iceoryx2-bb-container",
    "//iceoryx2-bb/elementary:iceoryx2-bb-elementary",
    "//iceoryx2-bb/elementary-traits:iceoryx2-bb-elementary-traits",
    "//iceoryx2-bb/flatbuffers:iceoryx2-bb-flatbuffers",
    "//iceoryx2-bb/lock-free:iceoryx2-bb-lock-free",
    "//iceoryx2-log/log:iceoryx2-log",
    "//iceoryx2-bb/loggers:iceoryx2-bb-loggers",
    "//iceoryx2-bb/posix:iceoryx2-bb-posix",
    "//iceoryx2-bb/system-types:iceoryx2-bb-system-types",
    "//iceoryx2-cal:iceoryx2-cal",
    "//iceoryx2-bb/concurrency:iceoryx2-bb-concurrency",
    "@crate_index//:serde",
]

ICEORYX2_FFI_C_PROC_MACRO_DEPS = [
    "//iceoryx2-bb/derive-macros:iceoryx2-bb-derive-macros",
    "//iceoryx2-ffi/ffi-macros:iceoryx2-ffi-macros",
]

rust_shared_library(
    name = "iceoryx2-ffi-c-shared-rust",
    srcs = ICEORYX2_FFI_C_SRC,
    crate_features = ICEORYX2_FFI_C_FEATURES,
    proc_macro_deps = ICEORYX2_FFI_C_PROC_MACRO_DEPS,
    tags = ["exclusive"],
    deps = ICEORYX2_FFI_C_DEPS,
)

rust_static_library(
    name = "iceoryx2-ffi-c-static-rust",
    srcs = ICEORYX2_FFI_C_SRC,
    crate_features = ICEORYX2_FFI_C_FEATURES,
    proc_macro_deps = ICEORYX2_FFI_C_PROC_MACRO_DEPS,
    tags = ["exclusive"],
    deps = ICEORYX2_FFI_C_DEPS,
)

# Combined library with header file

# POSIX timers and shared memory live in librt on the toolchain's glibc.
ICEORYX2_FFI_C_LINKOPTS = select({
    "@platforms//os:linux": ["-lrt"],
    "//conditions:default": [],
})

cc_library(
    name = "iceoryx2-ffi-c-shared",
    hdrs = ["include/iox2/iceoryx2.h"],
    includes = ["include"],
    linkopts = ICEORYX2_FFI_C_LINKOPTS,
    linkstatic = False,
    deps = [
        ":iceoryx2-ffi-c-cbindgen",
        ":iceoryx2-ffi-c-shared-rust",
    ],
)

cc_library(
    name = "iceoryx2-ffi-c-static",
    hdrs = ["include/iox2/iceoryx2.h"],
    includes = ["include"],
    linkopts = ICEORYX2_FFI_C_LINKOPTS,
    linkstatic = True,
    deps = [
        ":iceoryx2-ffi-c-cbindgen",
        ":iceoryx2-ffi-c-static-rust",
    ],
)

rust_test(
    name = "iceoryx2-ffi-c-tests",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ICEORYX2_FFI_C_FEATURES,
    proc_macro_deps = ICEORYX2_FFI_C_PROC_MACRO_DEPS + [
        "@crate_index//:generic-tests",
    ],
    deps = ICEORYX2_FFI_C_DEPS + [
        "//iceoryx2-bb/testing:iceoryx2-bb-testing",
    ],
)
