module(
    name = "iceoryx2_bazel_example",
    version = "0.0.0",
    bazel_compatibility = [">=8.5.1"],
)

# ==============================================================================
# Bazel Dependencies
# ==============================================================================

bazel_dep(name = "rules_rs", version = "0.0.112")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "llvm", version = "0.8.18")
bazel_dep(name = "iceoryx2")

# ==============================================================================
# Iceoryx2 Setup
# ==============================================================================

# Override iceoryx2 to use the local parent directory.
# For external projects, change this path or use git_override/archive_override.
local_path_override(
    module_name = "iceoryx2",
    path = "../..",
)

# ==============================================================================
# LLVM Toolchain Setup
# ==============================================================================

# rules_rs uses the LLVM toolchain registered below for C/C++ builds.
# iceoryx2 supplies self-contained bindgen toolchains, so no separate
# clang or libclang setup is needed here.

# ==============================================================================
# Rust Toolchain Setup
# ==============================================================================

rust = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust.toolchain(
    edition = "2024",
    version = "1.89.0",
)
use_repo(rust, "default_rust_toolchains")

# ==============================================================================
# Toolchain Registration
# ==============================================================================

# Register Rust and LLVM toolchains for this root module.
# iceoryx2 registers its bindgen toolchains as a dependency.
register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)
