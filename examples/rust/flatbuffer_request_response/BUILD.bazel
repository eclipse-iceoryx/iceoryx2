load("@rules_rs//rs:rust_binary.bzl", "rust_binary")

rust_binary(
    name = "server",
    srcs = [
        "data_props_generated.rs",
        "server.rs",
        "unbounded_data_generated.rs",
    ],
    deps = [
        "//examples/rust:examples-common",
        "//iceoryx2",
        "//iceoryx2-bb/loggers:iceoryx2-bb-loggers",
        "//iceoryx2-log/log:iceoryx2-log",
        "@crate_index//:flatbuffers",
    ],
)

rust_binary(
    name = "client",
    srcs = [
        "client.rs",
        "data_props_generated.rs",
        "unbounded_data_generated.rs",
    ],
    deps = [
        "//examples/rust:examples-common",
        "//iceoryx2",
        "//iceoryx2-bb/loggers:iceoryx2-bb-loggers",
        "//iceoryx2-log/log:iceoryx2-log",
        "@crate_index//:flatbuffers",
    ],
)
