+++ b/rs/private/bazel7_compat.bzl
@@ -0,0 +1,17 @@
+"""Dictionary-backed sets for Bazel 7."""
+
+def make_set(items = []):
+    """Returns a dictionary whose keys represent a mutable set."""
+    return {item: None for item in items}
+
+def set_difference_update(values, items):
+    """Removes items from a dictionary-backed set."""
+    for item in list(items):
+        values.pop(item, None)
+
+def set_intersection_update(values, items):
+    """Retains only items that occur in both sets."""
+    allowed = make_set(items)
+    for item in list(values):
+        if item not in allowed:
+            values.pop(item)
