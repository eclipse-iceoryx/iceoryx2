#### Common Setup

set REPO_ROOT [exec git rev-parse --show-toplevel]
cd ${REPO_ROOT}

source ${REPO_ROOT}/internal/end-to-end-testing/common.exp

#### Test Setup

set timeout 10

exec cargo build --bin iox2 --bin iox2-link 2>@1
exec cargo build --manifest-path integrations/zenoh/Cargo.toml --bin iox2-link-tunnel-zenoh 2>@1

# Installed commands are found by their name alone, build outputs carry the
# build type as a suffix.
set env(PATH) "${REPO_ROOT}/target/debug:${REPO_ROOT}/integrations/zenoh/target/debug:$env(PATH)"

#### Test

spawn iox2 link tunnel --list
set id_iox2 $spawn_id

#### Test Assertion

expect_output_from $id_iox2 "Discovered Commands:"
expect_output_from $id_iox2 "zenoh"
expect -i $id_iox2 eof

show_test_passed
