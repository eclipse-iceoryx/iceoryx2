load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

rust_library(
    name = "iceoryx2-link-host-to-host-tests",
    srcs = glob(["common/src/*.rs"]),
    crate_features = select({
        "//:cfg_feature_std": [
            "std",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//iceoryx2",
        "//iceoryx2-bb/container:iceoryx2-bb-container",
        "//iceoryx2-log/log:iceoryx2-log",
        "@crate_index//:clap",
    ],
)

rust_binary(
    name = "link-host-to-host-pinger",
    srcs = [
        "ping-pong/src/pinger.rs",
    ],
    deps = [
        ":iceoryx2-link-host-to-host-tests",
        "//iceoryx2",
        "//iceoryx2-bb/posix:iceoryx2-bb-posix",
        "//iceoryx2-log/log:iceoryx2-log",
        "@crate_index//:clap",
    ],
)

rust_binary(
    name = "link-host-to-host-ponger",
    srcs = [
        "ping-pong/src/ponger.rs",
    ],
    deps = [
        ":iceoryx2-link-host-to-host-tests",
        "//iceoryx2",
        "//iceoryx2-bb/posix:iceoryx2-bb-posix",
        "//iceoryx2-log/log:iceoryx2-log",
        "@crate_index//:clap",
    ],
)
